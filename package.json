{
  "name": "network-menubar",
  "version": "1.0.0",
  "description": "Shows network machines in your macOS menu bar",
  "main": "index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": ["menubar", "network", "discovery", "mac"],
  "author": "Sebastian Alsina",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "electron": "^28.0.0"
  },
  "dependencies": {
    "ip": "^1.1.9",
    "bonjour": "^3.5.0",
    "ping": "^0.4.4"
  },
  "config": {
    "forge": {
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {}
        }
      ],
      "makers": [
        {
          "name": "@electron-forge/maker-dmg",
          "platforms": ["darwin"],
          "config": {
            "name": "Network Menubar"
          }
        }
      ]
    }
  }
}
