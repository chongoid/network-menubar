{
  "name": "network-menubar",
  "version": "1.2.1",
  "description": "Shows network machines in your macOS menu bar",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "menubar",
    "network",
    "discovery",
    "mac"
  ],
  "author": "Sebastian Alsina",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ip": "^1.1.9"
  },
  "build": {
    "appId": "com.clawd.network-menubar",
    "productName": "Network Menubar",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist"
    },
    "directories": {
      "output": "dist"
    }
  }
}
