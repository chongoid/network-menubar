{
  "name": "network-menubar",
  "version": "1.3.0",
  "description": "Shows network machines in your macOS menu bar",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac-universal": "electron-builder --mac --x64 --arm64"
  },
  "keywords": [
    "menubar",
    "network",
    "discovery",
    "mac"
  ],
  "author": "Sebastian Alsina",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ip": "^1.1.9"
  },
  "build": {
    "appId": "com.clawd.network-menubar",
    "productName": "Network Menubar",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "index.html",
      "welcome.html",
      "renderer.js",
      "preload.js",
      "network-scanner.js",
      "icon.png",
      "icon.icns",
      "package.json",
      "entitlements.plist"
    ],
    "extraResources": [
      {
        "from": "fix-gatekeeper.sh",
        "to": "fix-gatekeeper.sh"
      }
    ],
    "publish": null
  }
}
